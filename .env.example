# UrbanPulse - Environment Variables
# Copy this file to .env before launching:
# cp .env.example .env

# PostgreSQL Credentials & Configuration
POSTGRES_USER=urbanpulse_user
POSTGRES_PASSWORD=urbanpulse_secure_pass_2026
POSTGRES_DB=urbanpulse
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application Service Host Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Base URL (optional - defaults to relative path reverse-proxy)
VITE_API_BASE_URL=
